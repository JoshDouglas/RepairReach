@model IEnumerable<RepairReach.Core.Model.Part>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<h2>Parts</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th></th>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Amount)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CostAmount)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.PartNumber)
        </th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            <a href="@Url.Action("Edit", new { id=item.PartId })"><button class="btn"><i class="icon-search"></i> Open</button></a>
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Amount)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CostAmount)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PartNumber)
        </td>
    </tr>
}

</table>
