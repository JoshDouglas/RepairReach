@model RepairReach.Core.Model.JobNote

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<div class="row-fluid">
    <div class="span12">
        <div class="box box-color box-bordered">
            <div class="box-title">
                <h3>
                    <i class="icon-edit"></i>
                    Edit Note
                </h3>
            </div>
            <div class="box-content">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true)
                        @Html.HiddenFor(model => model.JobNoteId)
                        @Html.HiddenFor(model => model.JobId)
                        @Html.HiddenFor(model => model.CreatedBy)
                        @Html.HiddenFor(model => model.CreatedDate)

                        @if (ViewBag.NoteCreatedByDifferentUser == true)
                        {
                            <div style="color:red">This note cannot be edited - it wasn't created by a different user.</div>
                            <br />
                        }

                        <div class="form-group">
                            @Html.LabelFor(model => model.Note, new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @if (ViewBag.NoteCreatedByDifferentUser == false)
                                {
                                    @Html.TextAreaFor(model => model.Note)
                                }
                                else
                                {
                                    @Html.TextAreaFor(model => model.Note, new { @readonly = "readonly" })
                                }
                                @Html.ValidationMessageFor(model => model.Note)
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-offset-2 col-md-10">
                                @if (ViewBag.NoteCreatedByDifferentUser == false)
                                {
                                    <input type="submit" value="Save" class="btn btn-primary" />
                                }
                            </div>
                        </div>
                    </div>
                }

                <div>
                    @Html.ActionLink("Back", "Edit", "Job", new { id = Model.JobId }, null) |
                    @if (ViewBag.NoteCreatedByDifferentUser == false)
                    {
                        @Html.ActionLink("Delete", "Delete", new { id = Model.JobNoteId })
                    }

                </div>
            </div>
        </div>
    </div>
</div>
