@model RepairReach.WebApplication.ViewModels.ApplianceViewModel

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<div class="row-fluid">
    <div class="span12">
        <div class="box box-color box-bordered">
            <div class="box-title">
                <h3>
                    <i class="icon-remove"></i>
                    Delete Appliance
                </h3>
            </div>
            <div class="box-content">
                <h3>Are you sure you want to delete this?</h3>
                <div>
                    <dl class="dl-horizontal">
                        <dt>
                            @Html.DisplayNameFor(model => model.Appliance.Make)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.Appliance.Make)
                        </dd>

                        <dt>
                            @Html.DisplayNameFor(model => model.Appliance.Type)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.Appliance.Type)
                        </dd>

                        <dt>
                            @Html.DisplayNameFor(model => model.Appliance.ModelNumber)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.Appliance.ModelNumber)
                        </dd>

                        <dt>
                            @Html.DisplayNameFor(model => model.Appliance.SerialNumber)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.Appliance.SerialNumber)
                        </dd>
                        
                        <dt>
                            @Html.DisplayNameFor(model => model.Appliance.ProblemDescription)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.Appliance.ProblemDescription)
                        </dd>

                    </dl>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.Appliance.JobId)
                        @Html.HiddenFor(model => model.Appliance.ApplianceId)
                        @Html.HiddenFor(model => model.Appliance.Type)
                        @Html.HiddenFor(model => model.Appliance.Make)
                        @Html.HiddenFor(model => model.Appliance.ModelNumber)
                        @Html.HiddenFor(model => model.Appliance.SerialNumber)

                        <div class="form-actions no-color">
                            <input type="submit" value="Delete" class="btn btn-primary" /> |
                            @Html.ActionLink("Back", "Edit", "Job", new { id = Model.Appliance.JobId }, null)
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
