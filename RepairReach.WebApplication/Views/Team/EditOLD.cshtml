@model RepairReach.WebApplication.ViewModels.StaffAccountViewModel

@{
    ViewBag.Title = "Edit";
}

<div class="row-fluid">
    <div class="span12">
        <div class="box box-color box-bordered">
            <div class="box-title">
                <h3>
                    <i class="icon-user"></i>
                    Edit Team Member
                </h3>
            </div>
            <div class="box-content">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true)
                        @Html.HiddenFor(model => model.Staff.StaffId)
                        @Html.HiddenFor(model => model.Staff.IsActive)

                        <div class="form-group">
                            @Html.LabelFor(model => model.Staff.DisplayName, new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Staff.DisplayName, new { @readonly = "readonly" })
                                @Html.ValidationMessageFor(model => model.Staff.DisplayName)
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Staff.FirstName, new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Staff.FirstName)
                                @Html.ValidationMessageFor(model => model.Staff.FirstName)
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Staff.LastName, new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Staff.LastName)
                                @Html.ValidationMessageFor(model => model.Staff.LastName)
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Staff.UserTitle, "UserTitle", new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.DropDownListFor(model => model.Staff.UserTitle, @ViewBag.UserTitle as SelectList)
                                @Html.ValidationMessageFor(model => model.Staff.UserTitle)
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Staff.Phone, new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Staff.Phone)
                                @Html.ValidationMessageFor(model => model.Staff.Phone)
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Staff.Email, new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Staff.Email)
                                @Html.ValidationMessageFor(model => model.Staff.Email)
                            </div>
                        </div>

                        @*<div class="form-group">
                                @Html.LabelFor(model => model.Password, new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.PasswordFor(model => model.Password)
                                    @Html.ValidationMessageFor(model => model.Password)
                                </div>
                            </div>*@

                        @if (User.Identity.Name == "DemoAdmin")
                        {
                            <div class="form-group">
                                @Html.LabelFor(model => model.Staff.HourlyRate, new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.Staff.HourlyRate)
                                    @Html.ValidationMessageFor(model => model.Staff.HourlyRate)
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.Password, new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.PasswordFor(model => model.Password)
                                    @Html.ValidationMessageFor(model => model.Password)
                                </div>
                            </div>
                        }
                        else
                        {
                            @Html.HiddenFor(model => model.Password)
                        }

                        <div class="form-group">
                            <div class="col-md-offset-2 col-md-10">
                                <input type="submit" value="Save" class="btn btn-primary" />
                            </div>
                        </div>
                    </div>
                }

                <div>
                    @Html.ActionLink("Back to List", "Index") | @Html.ActionLink("Delete", "Delete", new { id = Model.Staff.StaffId })
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
