        </div>
    </div>
    <div class="box-content">
        <ul class="unstyled">
            <li>Work In Progress</li>
            <li>Work Scheduled</li>
            <li>Authorized Not Scheduled</li>
        </ul>
    </div>
</div>
@*Work In Progress End*@
