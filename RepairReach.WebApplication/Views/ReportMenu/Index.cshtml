@model RepairReach.Core.Model.Service

@{
    ViewBag.Title = "Report Menu";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<h2><i class="icon-bar-chart"></i> Reports</h2>

@*Estimates*@
<div class="box box-color box-bordered">
    <div class="box-title">
        <h3>
            Estimates
        </h3>
        <div class="actions">
            <a href="#" class="btn btn-mini content-slideUp"><i class="icon-angle-down"></i></a>
        </div>
    </div>
    <div class="box-content">
        <ul class="unstyled">
            <li>@Html.ActionLink("Non-Authorized Jobs", "NonAuthorizedJobs", "EstimateReport")</li>
        </ul>
    </div>
</div>
@*Estimates End*@
