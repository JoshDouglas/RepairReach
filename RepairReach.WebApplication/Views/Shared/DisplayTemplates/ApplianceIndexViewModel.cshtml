        <a href="@Url.Action("Edit", "Appliance", new { id=Model.ApplianceId })"><button class="btn"><i class="icon-search"></i> Open</button></a>
    </td>
    <td>
        @Html.DisplayFor(modelItem => Model.Type)
    </td>
