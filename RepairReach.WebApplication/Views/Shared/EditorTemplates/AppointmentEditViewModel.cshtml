@model RepairReach.WebApplication.ViewModels.AppointmentEditViewModel

@Html.HiddenFor(model => model.AppointmentId)
@Html.HiddenFor(model => model.JobId)
@Html.HiddenFor(model => model.CreatedBy)
@Html.HiddenFor(model => model.Created)

<div class="form-group">
    @Html.LabelFor(model => model.StartTime)
    <div class="col-md-10">
        @Html.TextBoxFor(model => model.StartDate, "{0:d}", new { @class = "input-small datepick" })
        @Html.ValidationMessageFor(model => model.StartDate)

        @Html.TextBoxFor(model => model.StartTime, "{0:t}", new { @class = "input-small timepicker" })
        @Html.ValidationMessageFor(model => model.StartTime)
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(model => model.EndTime)
    <div class="col-md-10">
        @Html.TextBoxFor(model => model.EndDate, "{0:d}", new { @class = "input-small datepick" })
        @Html.ValidationMessageFor(model => model.EndDate)

        @Html.TextBoxFor(model => model.EndTime, "{0:t}", new { @class = "input-small timepicker" })
        @Html.ValidationMessageFor(model => model.EndTime)
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(model => model.TechnicianStaffId)
    <div class="col-md-10">
        @Html.DropDownList("TechnicianStaffId", string.Empty)
        @Html.ValidationMessageFor(model => model.TechnicianStaffId)
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(model => model.Note)
    <div class="col-md-10">
        @Html.TextAreaFor(model => model.Note)
        @Html.ValidationMessageFor(model => model.Note)
    </div>
</div>

<div class="form-group">
    @Html.EditorFor(model => model.CallOnWay)
    Call On Way
    @Html.ValidationMessageFor(model => model.CallOnWay)
</div>

<div class="form-group">
    @Html.EditorFor(model => model.TextOnWay)
    Text On Way
    @Html.ValidationMessageFor(model => model.TextOnWay)
</div>