@model RepairReach.WebApplication.ViewModels.HowDidYouFindUsIndexViewModel
    
<tr>
    @Html.HiddenFor(modelItem => Model.HowDidYouFindUsId)
    <td>
        @Html.TextBoxFor(modelItem => Model.Description)
