@model RepairReach.WebApplication.ViewModels.JobCreateViewModel

@{
    ViewBag.Title = "Job - Create";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<script>
    jQuery(document).ready(function () {
        $("#CustomerSearch").change(function () {
            var id = $('#CustomerSearch').val();

            if (id.length > 0) {
                PopulateContact(id);
            } else {
                $('#Address1').val('');
                $('#Address2').val('');
                $('#City').val('');
                $('#State').val('');
                $('#Zipcode').val('');
                $('#ContactFirstName').val('');
                $('#ContactLastName').val('');
                $('#ContactPhone1').val('');
                $('#ContactPhone2').val('');
                $('#CustomerId').val(null);
                $('#CustomerDisplayName').val(null);
            }
        });

        function PopulateContact(id) {
            if (id.length == 0) return;
            var ServiceUrl = "/Customer/GetJsonAsync?id=" + id;
            var content = '';
            $.support.cors = true;
            $.ajax({
                type: 'GET',
                url: ServiceUrl,
                async: true,
                cache: false,
                crossDomain: true,
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                error: function (xhr, err) {
                },
                success: function (result, status) {
                    $('#Address1').val(result.Address1);
                    $('#Address2').val(result.Address2);
                    $('#City').val(result.City);
                    $('#State').val(result.State);
                    $('#Zipcode').val(result.Zipcode);
                    $('#ContactFirstName').val(result.FirstName);
                    $('#ContactLastName').val(result.LastName);
                    $('#ContactPhone1').val(result.Phone1);
                    $('#ContactPhone2').val(result.Phone2);
                    $('#CustomerId').val(result.CustomerId);
                    $('#CustomerDisplayName').val(result.DisplayName);
                }
            });
        }

        $("#CustomerSearch").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/Customer/GetTermJsonAsync",
                    type: "GET",
                    dataType: "json",
                    data: { term: request.term },
                    success: function(data) {
                        response($.map(data, function(item) {
                            return { label: item.DisplayName, value: item.CustomerId };
                        }));
                    }
                });
            },
            select: function (event, ui) {
                $(this).val(ui.item.label);
                PopulateContact(ui.item.value);
                return false;
            }
        });

    });
</script>

<div class="row-fluid">
    <div class="span12">
        <div class="box box-color box-bordered">
            <div class="box-title">
                <h3>
                    <i class="icon-wrench"></i>
                    Create Job
                </h3>
            </div>
            <div class="box-content">
                @using (Html.BeginForm("Create", "Job", FormMethod.Post, new {@class = "form-horiztonal"}))
                {
                    @Html.ValidationSummary(true)
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.EditorFor(model => Model)

                        <br />

                        <div class="form-group">
                            <div class="col-md-offset-2 col-md-10">
                                <input type="submit" value="Create" class="btn btn-primary" />
                            </div>
                        </div>
                        </div>

        }

        <div>
            @Html.ActionLink("Back to List", "Index")
        </div>
    </div>
        </div>
    </div>
</div>


