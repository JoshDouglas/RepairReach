                                    }
                                </table>
                            </div>
                        </div>
                        @*Notes End*@
                    </div>
                </div>

                @*Job Info Begin*@
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        <div class="form-horizontal">

                            @Html.ValidationSummary(true)
                            
                            @Html.EditorFor(model => Model)

