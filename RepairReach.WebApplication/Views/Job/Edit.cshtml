                                    <a href="@Url.Action("Create", "JobNote", new { jobId = Model.JobId})"><button class="btn"><i class="icon-plus"></i> New Note</button></a>
                                </p>

                                <table class="table">
                                    <tr>
                                        <th></th>
                                        <th>
                                            @Html.DisplayNameFor(model => Model.JobNotes.First().Note)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => Model.JobNotes.First().CreatedBy)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => Model.JobNotes.First().CreatedDate)
                                        </th>
                                    </tr>

                                    @foreach (var item in Model.JobNotes)
                                    {
