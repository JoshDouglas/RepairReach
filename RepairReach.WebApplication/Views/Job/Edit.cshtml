                        </th>
                        <th>
                            @Html.DisplayNameFor(model => Model.Payments.First().EnteredBy)
                        </th>
                    </tr>
                    
                    @{ decimal totalPaymentsAmount = 0;}

                    @foreach (var item in Model.Payments)
                    {
