@model RepairReach.WebApplication.ViewModels.JobEditViewModel

@{
    ViewBag.Title = "Job - " + Model.CustomerDisplayName;
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<script type='text/javascript'>
    $(document).ready(function () {
        $("#JobStatusId").change(function (e) {
            var status = $(this).find(':selected').text();
            var balanceDue = $('#BalanceDue').val();
            if (status == "Closed" && balanceDue != 0) {
                //disable save button
                $('input[type="submit"]').prop('disabled', true);
                //show error
                $("#closed-balance-due-error").show();
                //scroll to error div
                $('html,body').animate({ scrollTop: $('#closed-balance-due-error').offset().top }, 'slow');
            } else {
                //enable button
                $('input[type="submit"]').prop('disabled', false);
                //hide error
                $("#closed-balance-due-error").hide();
            }
        });

        $('#JobQuickStatusId').change(function (e) {
            var status = $(this).find(':selected').text();
            var balanceDue = $('#BalanceDue').val();
            if (status == "Closed" && balanceDue != 0) {
                //disable save button
                $('input[type="submit"]').prop('disabled', true);
                //show error
                $("#closed-balance-due-error").show();
                //scroll to error div
                $('html,body').animate({ scrollTop: $('#closed-balance-due-error').offset().top }, 'slow');
            } else {
                this.form.submit();
            }
        });

        $('#CantSendEmailButton').qtip({
            content: 'You and the customer both need emails in order to send this off!',
            show: 'mouseover',
            hide: 'mouseout'
        });
    });
</script>

@*there is a wierd conflict between bootstrap and qtip, so this css is required for it to work*@
<style>
    .btn.disabled, .btn[disabled], fieldset[disabled] .btn {
        cursor: pointer;
        pointer-events: auto;
    }
</style>

@*Tab box*@
<div class="box box-bordered box-color">
