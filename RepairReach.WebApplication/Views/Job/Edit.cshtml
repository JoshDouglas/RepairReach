        <h3><i class="icon-wrench"></i> Job - <a style="color: white;" href="@Url.Action("Edit", "Customer", new {id = @Model.CustomerId})">@Model.CustomerDisplayName</a></h3>
        @using (Html.BeginForm("UpdateStatus", "Job", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.JobId)
