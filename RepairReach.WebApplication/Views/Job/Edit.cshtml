                                </p>

                                <table class="table">
                                    <tr>
                                        <th></th>
                                        <th>
                                            @Html.DisplayNameFor(model => Model.Appliances.First().Type)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => Model.Appliances.First().Make)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => Model.Appliances.First().ModelNumber)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => Model.Appliances.First().SerialNumber)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => Model.Appliances.First().ProblemDescription)
                                        </th>
                                    </tr>

                                    @foreach (var item in Model.Appliances)
                                    {
