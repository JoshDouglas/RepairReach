@model IEnumerable<RepairReach.Core.Model.Job>

@{
    //ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<div class="row-fluid">
    <div class="span12">
        <div class="box box-color box-bordered">
            <div class="box-title">
                <h3>
                    <i class="icon-book"></i>
                    Receivables
                </h3>
            </div>
            <div class="box-content">
                <table class="table">
                    <tr>
                        <th></th>
                        <th>
                            @Html.DisplayNameFor(model => model.JobNumber)
                        </th>
                        <th>
                            Customer
                        </th>
                        <th>
                            Phone
                        </th>
                        <th>
                            Address
                        </th>
                        <th>
                            Aging
                        </th>
                        <th>
                            Total
                        </th>
                        <th>
                            Payments
                        </th>
                        <th>
                            Balance
                        </th>
                    </tr>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <a href="@Url.Action("Edit", "Job", new { id=item.JobId })"><button class="btn"><i class="icon-search"></i> Open</button></a>
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.JobNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Customer.DisplayName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Customer.Phone1)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.FullAddress)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Aging)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.GrandTotal)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.AmountPaid)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.BalanceDue)
                            </td>
                        </tr>
                    }

                </table>
            </div>
        </div>
    </div>
</div>

