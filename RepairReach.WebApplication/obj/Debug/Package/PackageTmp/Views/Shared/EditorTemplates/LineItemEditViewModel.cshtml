@model RepairReach.WebApplication.ViewModels.LineItemEditViewModel

@Html.HiddenFor(model => model.LineItemId)
@Html.HiddenFor(model => model.JobId)

<h5>Line Info</h5>

<div class="form-group">
    @Html.LabelFor(model => model.LineItemNumber, new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.TextBoxFor(model => model.LineItemNumber, new { @readonly = "readonly" })
        @Html.ValidationMessageFor(model => model.LineItemNumber)
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(model => model.StaffId, new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.DropDownList("StaffId", String.Empty)
        @Html.ValidationMessageFor(model => model.StaffId)
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(model => model.TaxRateId, new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.DropDownList("TaxRateId", String.Empty)
        @Html.ValidationMessageFor(model => model.TaxRateId)
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(model => model.Description, new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.TextBoxFor(model => model.Description)
        @Html.ValidationMessageFor(model => model.Description)
    </div>
</div>

<h5>Quick Line</h5>

<div class="form-group">
    <div class="control-label col-md-2">Enter:</div>
    <div class="col-md-10">
        <input type="text" id="QuickLineSearch" placeholder="Search for a quick line" />
    </div>
</div>

