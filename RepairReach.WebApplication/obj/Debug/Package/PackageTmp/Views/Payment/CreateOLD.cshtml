@model RepairReach.Core.Model.Payment

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<div class="row-fluid">
    <div class="span12">
        <div class="box box-color box-bordered">
            <div class="box-title">
                <h3>
                    <i class="icon-credit-card"></i>
                    Create Payment
                </h3>
            </div>
            <div class="box-content">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true)
                        @Html.HiddenFor(model => model.JobId)
                        @Html.HiddenFor(model => model.EnteredBy)

                        <div class="form-group">
                            @Html.LabelFor(model => model.PaymentMethod, new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.DropDownList("PaymentMethod")
                                @Html.ValidationMessageFor(model => model.PaymentMethod)
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.PaymentAmount, new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.PaymentAmount)
                                @Html.ValidationMessageFor(model => model.PaymentAmount)
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.DatePaid, new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.TextBoxFor(model => model.DatePaid, new { @class = "input-medium datepick" })
                                @Html.ValidationMessageFor(model => model.DatePaid)
                            </div>
                        </div>
                        
                        <br />

                        <div class="form-group">
                            <div class="col-md-offset-2 col-md-10">
                                <input type="submit" value="Create" class="btn btn-primary" />
                            </div>
                        </div>
                    </div>
                }

                <div>
                    @Html.ActionLink("Back", "Edit", "Job", new { id = Model.JobId }, null)
                </div>
            </div>
        </div>
    </div>
</div>
