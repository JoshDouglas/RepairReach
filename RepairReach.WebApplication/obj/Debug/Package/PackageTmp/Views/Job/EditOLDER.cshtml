@model RepairReach.Core.Model.Job

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        <h3>
		    <i class="icon-wrench"></i>
		    Job
	    </h3>
        <hr />

        @Html.ValidationSummary(true)
        @Html.HiddenFor(model => model.JobId)

        <div class="form-group">
            @Html.LabelFor(model => model.JobNumber, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.JobNumber, new { @readonly = "readonly" })
                @Html.ValidationMessageFor(model => model.JobNumber)
            </div>
        </div>
        
        <div class="form-group">
            @Html.LabelFor(model => model.CustomerId, "CustomerId", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("CustomerId", String.Empty)
                @Html.ValidationMessageFor(model => model.CustomerId)
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.JobStatusId, "JobStatusId", new { @class = "control-label col-md-2" })
