    <div>
        @Html.ActionLink("Back to List", "Index") | @Html.ActionLink("Delete", "Delete", new {id = Model.CustomerId})
    </div>

@*line items*@
<div class="box-title">
	<h3>
		<i class="icon-reorder"></i>
		Line Items
	</h3>
</div>

@Html.ActionLink("Create Line Item", "Create", "LineItem", new { jobId = Model.JobId}, null)

<table class="table">
    <tr>
        <th></th>
        <th>
            @Html.DisplayNameFor(model => model.LineItems.First().LineItemNumber)
        </th>
        <th>
            Appliance
        </th>
        <th>
            Tech
        </th>
        <th>
            @Html.DisplayNameFor(model => model.LineItems.First().PartName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.LineItems.First().PartAmount)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.LineItems.First().PartCost)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.LineItems.First().PartNumber)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.LineItems.First().ServiceName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.LineItems.First().ServiceAmount)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.LineItems.First().ServiceCost)
        </th>
        <th>
            Tax %
        </th>
        <th>
            Total
        </th>
    </tr>

@foreach (var item in Model.LineItems) {
    <tr>
        <td>
            <a href="@Url.Action("Edit", "LineItem", new { id=item.LineItemId })"><button class="btn"><i class="icon-search"></i> Open</button></a>
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.LineItemNumber)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Appliance.DisplayName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Technician.DisplayName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PartName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PartAmount)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PartCost)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PartNumber)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ServiceName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ServiceAmount)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ServiceCost)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.TaxRate.Amount)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.TotalAmount)
        </td>
    </tr>
}
</table>

@*job notes*@
<div class="box-title">
	<h3>
		<i class="icon-edit"></i>
		Notes
	</h3>
</div>

@Html.ActionLink("Create Note", "Create", "JobNote", new { jobId = Model.JobId}, null)

<table class="table">
    <tr>
        <th></th>
        <th>
            Category
        </th>
        <th>
            Note
        </th>
        <th>
            Created By
        </th>
        <th>
            Created On
        </th>
    </tr>

    @foreach (var item in Model.JobNotes) {
        <tr>
            <td>
                <a href="@Url.Action("Edit", "JobNote", new { id=item.JobNoteId })"><button class="btn"><i class="icon-search"></i> Open</button></a>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NoteCategory)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Note)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedBy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedDate)
            </td>
        </tr>
    }
</table>

@*payments*@
