    <h3>
        <i class="icon-credit-card"></i>
        Payments
    </h3>
</div>

@Html.ActionLink("Create Payment", "Create", "Payment", new { jobId = Model.JobId }, null)

<table class="table">
    <tr>
        <th></th>
        <th>
            Method
        </th>
        <th>
            Amount
        </th>
        <th>
            Date
        </th>
        <th>
            Entered By
        </th>
