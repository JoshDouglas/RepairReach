@using RepairReach.WebApplication.ViewModels
@model RepairReach.WebApplication.ViewModels.MapViewModel

@{
    ViewBag.Title = "Index";
}
@section scripts
{
    <script src="http://maps.google.com/maps/api/js?sensor=false&language=en"></script>
    function initialize() {
    var jobs = $(".job");
    var markers = new Array();
    var mapOptions = {
       ...
    }};
    var mapCanvas = document.getElementById('map1');
    if (mapCanvas != null) {
        map = new google.maps.Map(mapCanvas, mapOptions);

        $.each(jobs, function (key, value) {
            markers[key] = new google.maps.Marker({
              map: map,
              draggable: false,
              animation: google.maps.Animation.DROP,
              position: new google.maps.LatLng(
                  Number($(value).attr("data-latitude")),
                  Number($(value).attr("data-longitude")
               ));
            });

            google.maps.event.addListener(markers[key], 'click', function () {
                // If you need this...
            });
        });
    }
}
}

@foreach (JobMapViewModel job in Model.Jobs)
{
    <div class="job" data-latitude="@(job.Latitude)" data-longitude="@(job.Longitude)">
        <span>@job.Name</span>
    </div>
}
<div class="row-fluid">
<div class="span6">
    <div class="box">
        <div class="box-title">
            <h3>
                <i class="icon-map-marker"></i>
                Basic map
            </h3>
        </div>
        <div class="box-content">
            <div id="map1"></div>
        </div>
    </div>
</div>
                    </div>

