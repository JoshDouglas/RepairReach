@model IEnumerable<RepairReach.Core.Model.TimeClockEntry>

@{
    ViewBag.Title = "TimeClock";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<div class="row-fluid">
    <div class="span12">
        <div class="box box-color box-bordered">
            <div class="box-title">
                <h3>
                    <i class="icon-time"></i>
                    Time Clock
                </h3>
            </div>
            <div class="box-content">
                <p>
                    @if (ViewBag.CanClockIn == true)
                    { <a href="@Url.Action("ClockIn", new { staffId = ViewBag.StaffId })"><button class="btn"><i class="icon-clock"></i> Clock In</button></a> }
                    @if (ViewBag.CanClockOut == true)
                    { <a href="@Url.Action("ClockOut", new { staffId = ViewBag.StaffId })"><button class="btn"><i class="icon-clock"></i> Clock Out</button></a> }
                </p>
                <table class="table">
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Staff.DisplayName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.DateWorkedDisplay)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.TimeInDisplay)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.TimeOutDisplay)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.HoursWorked)
                        </th>
                    </tr>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Staff.DisplayName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DateWorkedDisplay)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TimeInDisplay)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TimeOutDisplay)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.HoursWorked)
                            </td>
                        </tr>
                    }

                </table>

            </div>
        </div>
    </div>
</div>

