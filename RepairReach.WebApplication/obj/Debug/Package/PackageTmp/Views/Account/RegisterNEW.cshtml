@model RepairReach.WebApplication.ViewModels.RegisterViewModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
	<!-- Apple devices fullscreen -->
	<meta name="apple-mobile-web-app-capable" content="yes" />
	<!-- Apple devices fullscreen -->
	<meta names="apple-mobile-web-app-status-bar-style" content="black-translucent" />
	
	<title>Register - Repair Manager</title>

	@Styles.Render("~/Content/flat/accountcss")
    @Scripts.Render("~/bundles/accountjquery")

	<!--[if lte IE 9]>
		<script src="js/plugins/placeholder/jquery.placeholder.min.js"></script>
		<script>
			$(document).ready(function() {
				$('input, textarea').placeholder();
			});
		</script>
	<![endif]-->
	
	<!-- Favicon -->
	<link rel="shortcut icon" href="@Url.Content("~/Content/flat/img/favicon.ico")" />
	<!-- Apple devices Homescreen icon -->
	<link rel="apple-touch-icon-precomposed" href="@Url.Content("~/Content/flat/img/apple-touch-icon-precomposed.png")" />

</head>
<body class='login'>
	<div class="wrapper">
		<h1><a href="index.html"><img src="@Url.Content("~/Content/flat/img/logo-big.png")" alt="" class='retina-ready' width="59" height="49"></a></h1>
		<div class="login-body">
			<h2>REGISTER</h2>
            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new {@class = "form-validate"})) {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true)
				<div class="control-group">
					<div class="email controls">
                        @Html.TextBoxFor(m => m.UserName,
                            new Dictionary<string, object> { {"name", "uemail" }, {"placeholder", "Username"}, {"class", "input-block-level"}, {"data-rule-required", "true"}, {"data-rule-email", "true"} })
                        @Html.ValidationMessageFor(m => m.UserName)
					</div>
				</div>
				<div class="control-group">
					<div class="pw controls">
                        @Html.PasswordFor(m => m.Password,
                            new Dictionary<string, object> { {"name", "upw" }, {"placeholder", "Password"}, {"class", "input-block-level"}, {"data-rule-required", "true"} })
                        @Html.ValidationMessageFor(m => m.Password)
					</div>
				</div>
                <div class="control-group">
					<div class="pw controls">
                        @Html.PasswordFor(m => m.ConfirmPassword,
                            new Dictionary<string, object> { {"name", "upw" }, {"placeholder", "Confirm Password"}, {"class", "input-block-level"}, {"data-rule-required", "true"} })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword)
					</div>
				</div>
				<div class="submit">
					<input type="submit" value="Register" class='btn btn-primary'>
				</div>
            }
            <div class="forget">
				<span>&nbsp</span>
			</div>
		</div>
	</div>
	
</body>
</html>
