@using System.Activities.Expressions
@using System.Linq;
@using RepairReach.Data;
@using RepairReach.Data.Repositories

@{
    var context = new RepairReachContext();
    var jobCount = context.Jobs.Count(j => j.JobStatus.Description.ToLower().Equals("closed") == false);
    var closedJobCount = context.Jobs.Count(j => j.JobStatus.Description.ToLower().Equals("closed") == true);
    var customerCount = context.Customers.Count();
    var receivablesCount = context.Jobs.ToList().Count(j => j.BalanceDue > 0 && j.JobClosed.HasValue); //TODO: optimize later
}

@{
    var logoUrl = string.Empty;
    var singleOrDefault = context.Companies.SingleOrDefault();
    if (singleOrDefault != null)
    {
        logoUrl = singleOrDefault.LogoPath;
    }
}

