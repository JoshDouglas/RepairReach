@model RepairReach.Core.Model.LineItem

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<div class="row-fluid">
    <div class="span12">
        <div class="box box-color box-bordered">
            <div class="box-title">
                <h3>
                    <i class="icon-remove"></i>
                    Delete Line Item
                </h3>
            </div>
            <div class="box-content">
                <h3>Are you sure you want to delete this?</h3>
                <div>
                    <dl class="dl-horizontal">
                        <dt>
                            @Html.DisplayNameFor(model => model.Job.JobNumber)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.Job.JobNumber)
                        </dd>
                        <dt>
                            @Html.DisplayNameFor(model => model.TaxRate.Name)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.TaxRate.Name)
                        </dd>

                        <dt>
                            @Html.DisplayNameFor(model => model.Technician.DisplayName)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.Technician.DisplayName)
                        </dd>

                        <dt>
                            @Html.DisplayNameFor(model => model.LineItemNumber)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.LineItemNumber)
                        </dd>

                    </dl>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-actions no-color">
                            <input type="submit" value="Delete" class="btn btn-primary" /> |
                            @Html.ActionLink("Back", "Edit", "Job", new { id = Model.JobId }, null)
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
