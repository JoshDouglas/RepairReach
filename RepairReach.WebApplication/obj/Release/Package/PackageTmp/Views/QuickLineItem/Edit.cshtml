@model RepairReach.Core.Model.QuickLineItem

@{
    ViewBag.Title = "Edit";
}

<div class="row-fluid">
    <div class="span12">
        <div class="box box-color box-bordered">
            <div class="box-title">
                <h3>
                    <i class="icon-reorder"></i>
                    Edit Quick Line
                </h3>
            </div>
            <div class="box-content">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.QuickLineItemId)

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true)

                        <div class="form-group">
                            @Html.LabelFor(model => model.Description, new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Description)
                                @Html.ValidationMessageFor(model => model.Description)
                            </div>
                        </div>

                        <h5>Part</h5>

                        <div class="form-group">
                            @Html.LabelFor(model => model.PartName, new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.PartName)
                                @Html.ValidationMessageFor(model => model.PartName)
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.PartQty, new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.PartQty)
                                @Html.ValidationMessageFor(model => model.PartQty)
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.PartEach, new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.PartEach)
                                @Html.ValidationMessageFor(model => model.PartEach)
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.PartCost, new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.PartCost)
                                @Html.ValidationMessageFor(model => model.PartCost)
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.PartNumber, new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.PartNumber)
                                @Html.ValidationMessageFor(model => model.PartNumber)
                            </div>
                        </div>

                        <h5>Service</h5>

                        <div class="form-group">
                            @Html.LabelFor(model => model.ServiceName, new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.ServiceName)
                                @Html.ValidationMessageFor(model => model.ServiceName)
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.ServiceQty, new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.ServiceQty)
                                @Html.ValidationMessageFor(model => model.ServiceQty)
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.ServiceEach, new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.ServiceEach)
                                @Html.ValidationMessageFor(model => model.ServiceEach)
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.ServiceCost, new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.ServiceCost)
                                @Html.ValidationMessageFor(model => model.ServiceCost)
                            </div>
                        </div>

                        <br />

                        <div class="form-group">
                            <div class="col-md-offset-2 col-md-10">
                                <input type="submit" value="Save" class="btn btn-primary" />
                            </div>
                        </div>
                    </div>
                }

                <div>
                    @Html.ActionLink("Back to List", "Index") | @Html.ActionLink("Delete", "Delete", new {id = @Model.QuickLineItemId})
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
