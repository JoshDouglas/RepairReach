@using System.Web.UI.WebControls
@model RepairReach.Core.Model.Job

@{
    ViewBag.Title = "Payment Receipt";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<div class="row-fluid">
    <div class="span12">
        <div class="box box-color box-bordered">
            <div class="box-title">
                <h3>
                    <i class="icon-money"></i>
                    Payment Receipt
                </h3>
            </div>
            <div class="box-content">
                <div class="invoice-info">
                    <div class="invoice-name">
                        @ViewBag.Company.Name
                    </div>
                    <div class="invoice-from">
                        <span>From</span>
                        <strong>@ViewBag.Company.Name</strong>
                        <address>
                            @ViewBag.Company.Address1 &nbsp; @if (ViewBag.Company.Address2 != null)
                            { @ViewBag.Company.Address2;
                            } <br>
                            @ViewBag.Company.City, @ViewBag.Company.State @ViewBag.Company.Zipcode <br>
                            <abbr title="Phone">Phone:</abbr> @ViewBag.Company.Phone <br>
                            @if (ViewBag.Company.Fax != null)
                            {<abbr title="Fax">Fax:</abbr> @ViewBag.Company.Fax }
                        </address>
                    </div>
                    <div class="invoice-to">
                        <span>To</span>
                        <strong>@Model.Customer.DisplayName</strong>
                        <address>
                            @Model.Customer.Address1 &nbsp; @if (Model.Customer.Address2 != null)
                            { @Model.Customer.Address2;
                            } <br>
                            @Model.Customer.City, @Model.Customer.State @Model.Customer.Zipcode <br>
                            <abbr title="Phone">Phone:</abbr> @Model.Customer.Phone1 <br>
                            @if (Model.Customer.Fax != null)
                            { <abbr title="Fax">Fax:</abbr> @Model.Customer.Fax }
                        </address>
                    </div>
                    <div class="invoice-infos">
                        <table>
                            <tbody>
                                <tr>
                                    <th>Billed:</th>
                                    <td>@Model.JobClosedDisplay</td>
                                </tr>
                                <tr>
                                    <th>Invoice #:</th>
                                    <td>@Model.JobNumber</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                @*line items*@
                <table class="table table-striped table-invoice">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th>Part Qty</th>
                            <th>Part Price</th>
                            <th>Part #</th>
                            <th>Labor Qty</th>
                            <th>Labor Price</th>
                            <th>Service Qty</th>
                            <th>Service Price</th>
                            <th>Tax</th>
                            <th class="tr">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            decimal subTotalAmount = 0;
                            decimal taxAmount = 0;
                            decimal totalAmount = 0;
                        }
                        @foreach (var item in Model.LineItems)
                        {
                            subTotalAmount += item.PreTaxAmount;
                            taxAmount += item.TaxAmount;

                            <tr>
                                <td>@item.Description</td>
                                <td>@item.PartQty</td>
                                <td>@item.PartEach</td>
                                <td>@item.PartNumber</td>
                                <td>@item.LaborQty</td>
                                <td>@item.LaborEach</td>
                                <td>@item.ServiceQty</td>
                                <td>@item.ServiceEach</td>
                                <td>@item.TaxAmount</td>
                                <td class="total">@item.TotalAmount</td>

                                @*<td>@item.Description</td>
                                    <td class="price">@item.TotalAmount</td>
                                    <td class="qty">1</td>
                                    <td class="total">@item.TotalAmount</td>*@
                            </tr>
                        }

                        <tr>
                            <td colspan="9"></td>
                            <td class="taxes">
                                <p>
                                    <span class="light">Subtotal</span>
                                    <span>@subTotalAmount</span>
                                </p>
                                <p>
                                    <span class="light">Tax&nbsp;&nbsp;&nbsp;</span>
                                    <span>@taxAmount</span>
                                </p>
                                <p>
                                    <span class="light">Total</span>
                                    <span class="totalprice">
                                        @Model.GrandTotal
                                    </span>
                                </p>
                            </td>
                        </tr>
                    </tbody>
                </table>
                @*end line items*@
                @*payments*@
                <h4>
                    <i class="icon-credit-card"></i>
                    Payments
                </h4>
                <table class="table table-striped table-invoice">
                    <thead>
                        <tr>
                            <th colspan="7"></th>
                            <th>Date</th>
                            <th>Method</th>
                            <th class="tr">Payment Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            decimal totalPayments = 0;
                        }
                        @foreach (var item in Model.Payments)
                        {
                            totalPayments += item.PaymentAmount;

                            <tr>
                                <td colspan="7"></td>
                                <td>@item.DatePaid</td>
                                <td>@item.PaymentMethod</td>
                                <td class="total">@item.PaymentAmount</td>

                            </tr>
                        }

                        <tr>
                            <td colspan="9"></td>
                            <td class="taxes">
                                <p>
                                    <span class="light">Total</span>
                                    <span class="totalprice">
                                        @Model.AmountPaid
                                    </span>
                                </p>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="9"></td>
                            <td class="taxes">
                                <p>
                                    <span class="light">Balance Due</span>
                                    <span class="totalprice">
                                        @Model.BalanceDue
                                    </span>
                                </p>
                            </td>
                        </tr>
                    </tbody>
                </table>
                @*end payments*@
            </div>
        </div>

    </div>
</div>