                            <div class="box-title">
                                <h3>
                                    <i class="glyphicon-nails"></i>
                                    Appliances
                                </h3>
                            </div>
                            <div class="box-content nopadding">
                                <br />
                                <p style="margin-left: 10px;">
                                    <a href="@Url.Action("Create", "Appliance", new {jobId = Model.JobId})"><button class="btn"><i class="icon-plus"></i> New Appliance</button></a>
                                </p>

                                <table class="table">
                                    <tr>
                                        <th></th>
                                        <th>
                                            Type
                                        </th>
                                        <th>
                                            Make
                                        </th>
                                        <th>
                                            Model
                                        </th>
                                        <th>
                                            Serial
                                        </th>
                                        <th>
                                            Description
                                        </th>
                                    </tr>

                                    @foreach (var item in Model.Appliances)
                                    {
                                        <tr>
                                            <td>
                                                <a href="@Url.Action("Edit", "Appliance", new { id=item.ApplianceId, jobId = Model.JobId })"><button class="btn"><i class="icon-search"></i> Open</button></a>
                                            </td>
                                            <td>
