@model RepairReach.Core.Model.Job

@{
    ViewBag.Title = "Job - " + Model.Customer.DisplayName;
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<script type='text/javascript'>
    $(document).ready(function () {
        $("#JobStatusId").change(function (e) {
            var status = $(this).find(':selected').text();
            var balanceDue = $('#BalanceDue').val();
            if (status == "Closed" && balanceDue > 0) {
                //disable save button
                $('input[type="submit"]').prop('disabled', true);

                //show error
                $("#closed-balance-due-error").show();
            } else {
                //enable button
                $('input[type="submit"]').prop('disabled', false);

                //hide error
                $("#closed-balance-due-error").hide();
            }
        });
    });
</script>

@*Tab box*@
<div class="box box-bordered box-color">
    <div class="box-title">
        <h3><i class="icon-wrench"></i> Job - @Model.Customer.DisplayName</h3>
    </div>
    <div class="box-content nopadding">
        <ul class="tabs tabs-inline tabs-top">
            <li class="active">
                <a href="#firstTab" data-toggle="tab"><i class="icon-wrench"></i> Job Info</a>
            </li>
            <li class="">
                <a href="#secondTab" data-toggle="tab"><i class="icon-reorder"></i> Line Items</a>
            </li>
            <li class="">
                <a href="#thirdTab" data-toggle="tab"><i class="icon-credit-card"></i> Payments</a>
            </li>
            <li class="">
                <a href="#fourthTab" data-toggle="tab"><i class="icon-bar-chart"></i> Forms</a>
            </li>
        </ul>
        <div class="tab-content padding tab-content-inline tab-content-bottom">
            <div class="tab-pane active" id="firstTab">
