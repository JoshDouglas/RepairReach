                                            <td>
                                                @Html.DisplayFor(modelItem => item.Make)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.ModelNumber)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.SerialNumber)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.ProblemDescription)
                                            </td>
                                        </tr>
                                    }
                                </table>
                            </div>
                        </div>
                    </div>
                    @*Appliances End*@
                </div>
                
                <div class="row-fluid">
                    @*Appointments Begin*@
                    <div class="span6">
                        <div class="box box-color box-bordered">
                            <div class="box-title">
                                <h3>
                                    <i class="icon-calendar"></i>
                                    Appointments
                                </h3>
                            </div>
                            <div class="box-content nopadding">
                                <br />
                                <p style="margin-left: 10px;">
                                    <a href="@Url.Action("Create", "Appointment", new { jobId = Model.JobId})"><button class="btn"><i class="icon-plus"></i> New Appointment</button></a>
                                </p>

                                <table class="table">
                                    <tr>
                                        <th></th>
                                        <th>
                                            Start
                                        </th>
                                        <th>
                                            End
                                        </th>
                                        <th>
                                            Technician
                                        </th>
                                        <th>
                                            Note
                                        </th>
                                    </tr>

                                    @foreach (var item in Model.Appointments)
                                    {
                                        var startTime = TimeZoneInfo.ConvertTimeFromUtc(item.StartTime, ViewBag.TimeZoneInfo);
                                        var endTime = TimeZoneInfo.ConvertTimeFromUtc(item.EndTime, ViewBag.TimeZoneInfo);
                                        <tr>
                                            <td>
                                                <a href="@Url.Action("Edit", "Appointment", new { id=item.AppointmentId })"><button class="btn"><i class="icon-search"></i> Open</button></a>
                                            </td>
                                            <td>
                                                @startTime
                                            </td>
                                            <td>
                                                @endTime
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Technician.DisplayName)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Note)
                                            </td>
                                        </tr>
                                    }
                                </table>
                            </div>
                        </div>
                    </div>
                    @*Appointments End*@
                    <div class="span6">
                        @*Notes Begin*@
                        <div class="box box-color box-bordered">
                            <div class="box-title">
                                <h3>
                                    <i class="icon-edit"></i>
                                    Notes
                                </h3>
                            </div>
                            <div class="box-content nopadding">
                                <br />
                                <p style="margin-left: 10px;">
                                    <a href="@Url.Action("Create", "JobNote", new { jobId = Model.JobId})"><button class="btn"><i class="icon-plus"></i> New Note</button></a>
                                </p>

                                <table class="table">
                                    <tr>
                                        <th></th>
                                        <th>
                                            Note
                                        </th>
                                        <th>
                                            Created By
                                        </th>
                                        <th>
                                            Created On
                                        </th>
                                    </tr>

                                    @foreach (var item in Model.JobNotes)
                                    {
                                        <tr>
                                            <td>
                                                <a href="@Url.Action("Edit", "JobNote", new { id=item.JobNoteId })"><button class="btn"><i class="icon-search"></i> Open</button></a>
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Note)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.CreatedBy)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.CreatedDate)
                                            </td>
                                        </tr>
                                    }
                                </table>
                            </div>
                        </div>
                        @*Notes End*@
                    </div>
                </div>

                @*Job Info Begin*@
                    @using (Html.BeginForm())
