                                @{ totalPaymentsAmount += item.PaymentAmount;}
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DatePaid)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.EnteredBy)
                            </td>
