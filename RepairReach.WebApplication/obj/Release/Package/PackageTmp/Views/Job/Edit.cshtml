                    </tr>
                    
                    <tr>
                        <td>
                            <a href="@Url.Action("Invoice", "Job", new { id=Model.JobId })"><button class="btn"><i class="icon-search"></i> View</button></a>
                        </td>
                        <td>
                            <a href="@Url.Action("InvoicePdf", "Job", new { id = Model.JobId })"><button class="btn"><i class="icon-file"></i> Pdf</button></a>
                        </td>
                        <td>
