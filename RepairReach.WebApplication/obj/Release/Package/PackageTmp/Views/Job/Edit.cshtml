                                <div class="alert alert-error">
                                    <button type="button" class="close" data-dismiss="alert">×</button>
                                    Cannot close a job that has a balance due.
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-md-offset-2 col-md-10">
                                    <input type="submit" value="Save" class="btn btn-primary" />
                                </div>
                            </div>
                        </div>
                    }
                    @*Job Info End*@
                
            </div>
            <div class="tab-pane" id="secondTab">
                @*Line Item Begin*@
                <p>
                    <a href="@Url.Action("Create", "LineItem", new { jobId = Model.JobId})"><button class="btn"><i class="icon-plus"></i> New Line Item</button></a>
                </p>

                <table class="table">
                    <tr>
                        <th></th>
                        <th>
                            Line Number
                        </th>
                        <th>
                            Tech
                        </th>
                        <th>
                            Description
                        </th>
                        <th>
                            Part Description
                        </th>
                        <th>
                            Part Amount
                        </th>
                        <th>
                            Part Cost
                        </th>
                        <th>Service Description</th>
                        <th>
                            Service Amount
                        </th>
                        <th>
                            Service Cost
                        </th>
                        <th>
                            Tax %
                        </th>
                        <th>
                            Total
                        </th>
                    </tr>
                    
                    @{decimal totalAmount = 0;}

                    @foreach (var item in Model.LineItems)
                    {
                        <tr>
                            <td>
                                <a href="@Url.Action("Edit", "LineItem", new { id=item.LineItemId })"><button class="btn"><i class="icon-search"></i> Open</button></a>
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.LineItemNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Technician.DisplayName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Description)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PartName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PartAmount)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PartCost)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ServiceName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ServiceAmount)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ServiceCost)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TaxRate.Amount)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TotalAmount)
                                @{ totalAmount += item.TotalAmount;}
                            </td>
                        </tr>
                    }
                    @*line item total row*@
                    <tr>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td>Total</td>
                        <td>
                            <b>@(Math.Round(totalAmount, 2, MidpointRounding.ToEven))</b>
                        </td>
                    </tr>
                </table>
                @*Line Item End*@
            </div>
            <div class="tab-pane" id="thirdTab">
                @*Payments Begin*@
