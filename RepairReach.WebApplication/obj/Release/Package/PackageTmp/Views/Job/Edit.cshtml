                    }
                    @*payment totals row*@
                    <tr>
                        <td></td>
                        <td>Total</td>
                        <td><b>@(totalPaymentsAmount)</b></td>
                        <td></td>
                        <td></td>
                    </tr>
                </table>
                @*Payments End*@
            </div>
