@model IEnumerable<RepairReach.Core.Model.Vendor>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<div class="row-fluid">
    <div class="span12">
        <div class="box box-color box-bordered">
            <div class="box-title">
                <h3>
                    <i class="icon-group"></i>
                    Vendors
                </h3>
            </div>
            <div class="box-content">
                <p>
                    @Html.ActionLink("Create New", "Create")
                </p>
                <table class="table">
                    <tr>
                        <th></th>
                        <th>
                            @Html.DisplayNameFor(model => model.CompanyName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.CompanyPhone)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.FullAddress)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Contact1Name)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Contact2Name)
                        </th>
                    </tr>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <a href="@Url.Action("Edit", new { id=item.VendorId })"><button class="btn"><i class="icon-search"></i> Open</button></a>
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CompanyName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CompanyPhone)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.FullAddress)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Contact1Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Contact2Name)
                            </td>
                        </tr>
                    }

                </table>
            </div>
        </div>
    </div>
</div>
