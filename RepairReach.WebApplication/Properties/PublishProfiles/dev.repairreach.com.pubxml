<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Debug</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>dev.repairreach.com</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>True</LaunchSiteAfterPublish>
    <ExcludeApp_Data>True</ExcludeApp_Data>
    <MSDeployServiceURL>snowymountain.cloudapp.net</MSDeployServiceURL>
    <DeployIisAppPath>dev.repairreach.com</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>True</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>True</EnableMSDeployBackup>
    <UserName>snowyadmin</UserName>
    <_SavePWD>True</_SavePWD>
    <PublishDatabaseSettings>
      <Objects xmlns="">
        <ObjectGroup Name="RepairReach" Order="1" Enabled="True">
          <Destination Path="Data Source=.\SQLEXPRESS;Initial Catalog=Dev;User ID=sa;Password=J0nsnow8992!" Name="Server=.\SQLEXPRESS;Database=Dev;User ID=sa;Password=J0nsnow8992!" />
          <Object Type="DbCodeFirst">
            <Source Path="DBMigration" DbContext="RepairReach.Data.RepairReachContext, RepairReach.Data" MigrationConfiguration="RepairReach.Data.Migrations.Configuration, RepairReach.Data" Origin="Configuration" />
          </Object>
        </ObjectGroup>
      </Objects>
    </PublishDatabaseSettings>
    <_DestinationType>AzureVirtualMachine</_DestinationType>
  </PropertyGroup>
  <ItemGroup>
    <MSDeployParameterValue Include="$(DeployParameterPrefix)RepairReach-Web.config Connection String">
      <ParameterValue>Server=.\SQLEXPRESS;Database=Dev;User ID=sa;Password=J0nsnow8992!</ParameterValue>
    </MSDeployParameterValue>
  </ItemGroup>
</Project>