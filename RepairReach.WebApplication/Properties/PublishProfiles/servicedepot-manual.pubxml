<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Debug</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>http://servicedepot.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>True</LaunchSiteAfterPublish>
    <ExcludeApp_Data>True</ExcludeApp_Data>
    <MSDeployServiceURL>servicedepot.scm.azurewebsites.net:443</MSDeployServiceURL>
    <DeployIisAppPath>servicedepot</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>True</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>True</EnableMSDeployBackup>
    <UserName>$servicedepot</UserName>
    <_SavePWD>True</_SavePWD>
    <PublishDatabaseSettings>
      <Objects xmlns="">
        <ObjectGroup Name="RepairReachIMPORT" Order="1" Enabled="True">
          <Destination Path="Data Source=tcp:hr9bsz64tl.database.windows.net,1433;Initial Catalog=servicedepot_db;User ID=jonsnow@hr9bsz64tl;Password=Snowy12345!" />
          <Object Type="DbCodeFirst">
            <Source Path="DBMigration" DbContext="RepairReach.Data.RepairReachContext, RepairReach.Data" MigrationConfiguration="RepairReach.Data.Migrations.Configuration, RepairReach.Data" Origin="Configuration" />
          </Object>
        </ObjectGroup>
      </Objects>
    </PublishDatabaseSettings>
  </PropertyGroup>
  <ItemGroup>
    <MSDeployParameterValue Include="$(DeployParameterPrefix)RepairReachIMPORT-Web.config Connection String">
      <ParameterValue>Data Source=tcp:hr9bsz64tl.database.windows.net,1433;Initial Catalog=servicedepot_db;User ID=jonsnow@hr9bsz64tl;Password=Snowy12345!</ParameterValue>
    </MSDeployParameterValue>
  </ItemGroup>
</Project>